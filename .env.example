# Clerk — get your publishable key from Clerk Dashboard → API Keys
# (Frontend API key starting with "pk_"). Without it, the admin panel is
# inaccessible (unless VITE_ADMIN_DEV_BYPASS=true for local dev only).
VITE_CLERK_PUBLISHABLE_KEY=

# DEV ONLY: set to "true" to skip Clerk auth while developing the admin UI.
# NEVER enable this in production.
VITE_ADMIN_DEV_BYPASS=false

# Backend API base URL. Leave as /api to use the Vite dev proxy.
VITE_API_URL=/api

# Public site URL (no trailing slash), e.g. https://www.tokkishopve.com
# Consumed at RUNTIME by `server/og-server.mjs` when generating Open Graph /
# Twitter embed HTML for social crawlers on /products/:id (defaults to
# https://www.tokkishopve.com when unset). Set it in Coolify →
# Environment Variables (runtime variable for the server).
# NOT a Vite variable — not read by the client bundle (the index.html
# OG/canonical tags ship hardcoded to the production domain).
VITE_PUBLIC_SITE_URL=https://www.tokkishopve.com

# Backend origin (no trailing slash), e.g. https://tokkiweb-backend.onrender.com
# Used by `server/og-server.mjs` to reverse-proxy /api/* requests to the
# backend server-side (avoids CORS entirely). Set this in Coolify →
# Environment Variables (runtime variable for the server).
# NOT a Vite variable — only consumed at runtime by og-server.mjs.
BACKEND_URL=https://your-backend.example
