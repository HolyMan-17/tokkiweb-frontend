{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/products/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|telegrambot|whatsapp|discordbot|slackbot|linkedinbot|pinterest|google-pagerenderer|bingbot).*$"
        }
      ],
      "destination": "/api/og-product?id=:id"
    },
    {
      "source": "/categorias/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|telegrambot|whatsapp|discordbot|slackbot|linkedinbot|pinterest|google-pagerenderer|bingbot).*$"
        }
      ],
      "destination": "/api/og-product?category=:slug"
    },
    {
      "source": "/api/((?!og-product).*)",
      "destination": "https://api.tokkishopve.com/api/$1"
    },
    {
      "source": "/images/:match*",
      "destination": "https://api.tokkishopve.com/images/:match*"
    },
    {
      "source": "/((?!api/|images/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
