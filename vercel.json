{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.tokkishopve.com/api/:match*"
    },
    {
      "source": "/images/:match*",
      "destination": "https://api.tokkishopve.com/images/:match*"
    },
    {
      "source": "/((?!api/|images/).*)",
      "destination": "/index.html"
    }
  ]
}
