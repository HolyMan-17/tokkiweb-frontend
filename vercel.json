{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.tokkishopve.com/api/:match*"
    },
    {
      "source": "/images/:match*",
      "destination": "https://api.tokkishopve.com/images/:match*"
    },
    {
      "source": "/((?!api/|images/).*)",
      "destination": "/index.html"
    }
  ]
}
