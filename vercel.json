{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "$BACKEND_URL/api/:path*"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/productos", "destination": "/index.html" },
    { "source": "/categorias/:slug", "destination": "/index.html" },
    { "source": "/products/:id", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/confirmation/:orderId", "destination": "/index.html" },
    { "source": "/tokki-admin", "destination": "/index.html" },
    { "source": "/tokki-admin/orders", "destination": "/index.html" },
    { "source": "/tokki-admin/orders/:id", "destination": "/index.html" },
    { "source": "/tokki-admin/products", "destination": "/index.html" },
    { "source": "/tokki-admin/dev", "destination": "/index.html" },
    { "source": "/tokki-admin/sign-in", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
